# Database (development defaults)
DB_USER=antiquar
DB_PASSWORD=antiquar123
DB_NAME=antiquar_db
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Production overrides (fill in prod.env)
# PROD_DB_USER=
# PROD_DB_PASSWORD=
# PROD_DB_NAME=
# PROD_DB_PORT=5432
# PROD_DATABASE_URL=

# JWT / cookies (local: Vite :5173 → API :3000, no /api prefix)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_ACCESS_PATH=/
COOKIE_REFRESH_PATH=/auth

# Production (prod.env on VPS, same origin via nginx /api/):
# NODE_ENV=production
# FRONTEND_URL=https://tsehh.ru
# JWT_ACCESS_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# COOKIE_ACCESS_PATH=/api
# COOKIE_REFRESH_PATH=/api/auth
# If COOKIE_* paths are omitted, production defaults to /api and /api/auth.

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Production (prod.env on VPS):
# FRONTEND_URL=https://tsehh.ru

# Seed only (`make seed` / `prisma db seed`). Min 12 chars. Do not reuse a production password.
SEED_ADMIN_PASSWORD=change-me-local-only

# MinIO (development)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=antiquar-products
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# MinIO (production - fill in prod.env)
# PROD_MINIO_ENDPOINT=minio
# PROD_MINIO_PORT=9000
# PROD_MINIO_ACCESS_KEY=
# PROD_MINIO_SECRET_KEY=
# PROD_MINIO_BUCKET=antiquar-products
# PROD_MINIO_USE_SSL=true
# MINIO_PUBLIC_URL=https://tsehh.ru/minio

# Public self-signup. Closed by default; set both to true to reopen
ENABLE_PUBLIC_REGISTRATION=false
VITE_ENABLE_PUBLIC_REGISTRATION=false

# Frontend (Vite)
VITE_API_URL=http://localhost:3000
# VITE_BASE=/
