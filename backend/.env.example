FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-secret-key-change-in-production
# Short-lived access JWT in httpOnly cookie. Do not use multi-day values.
JWT_ACCESS_EXPIRATION=15m
# Refresh session lifetime (opaque token; only sha256 is stored in DB)
JWT_REFRESH_EXPIRATION=7d
# Local HTTP: secure=false. Production HTTPS (VPS): COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Local API is http://localhost:3000 (no /api prefix). Production nginx is /api/.
COOKIE_ACCESS_PATH=/
COOKIE_REFRESH_PATH=/auth
DATABASE_URL="postgresql://antiquar:antiquar123@localhost:5433/antiquar_db?schema=public"
ENABLE_IMAGE_COMPRESSION=true
# Product uploads always compress on the server (force); this flag is for other paths.
# Public self-signup. Closed by default; set true to reopen POST /auth/register
ENABLE_PUBLIC_REGISTRATION=false
# Used only by `prisma db seed`
SEED_ADMIN_PASSWORD=change-me-local-only
